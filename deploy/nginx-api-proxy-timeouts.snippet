# Incluir dentro do bloco `location` que faz proxy para a API (ex.: /api/v1/).
# Evita HTTP 502 quando uma única requisição demora (Evolution/WhatsApp).
#
# Uploads grandes (manual PDF no catálogo — até 100 MB):
#   client_max_body_size 100m;
#   client_body_timeout 120s;
# Ver VPS_NGINX_INSTRUCTIONS.txt na raiz do repositório.
proxy_connect_timeout 120s;
proxy_send_timeout 120s;
proxy_read_timeout 120s;
send_timeout 120s;
