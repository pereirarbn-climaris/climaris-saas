# Exemplo para copiar em `.env.beta` na raiz (API Beta / docker-compose.beta.yml).
# Não commite o ficheiro `.env.beta` real.

# Banco isolado — não usar erp_db (produção).
DATABASE_URL=postgresql+psycopg://erp_user:erp_password@db:5432/climaris_beta
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=erp_password
POSTGRES_DB=climaris_beta

JWT_SECRET_KEY=troque_em_beta_diferente_de_producao

# Mesmo valor que AUTHENTICATION_API_KEY em deploy/evolution/.env (se testar WhatsApp no Beta)
EVOLUTION_API_KEY=

APP_PUBLIC_URL=https://beta.climaris.com.br
API_PUBLIC_BASE_URL=https://beta.climaris.com.br
EVOLUTION_CORS_REQUEST_ORIGIN=https://beta.climaris.com.br

EVOLUTION_WEBHOOK_TOKEN=

# Beta: desligue workers que disparam mensagens reais ou jobs de produção.
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_PREVENTIVE_WORKER_ENABLED=false

# Cadastro público no Beta (opcional — ligue só se quiser testar onboarding).
PUBLIC_REGISTER_ENABLED=true

# Webhooks de pagamento: use sandbox ou deixe assinatura desligada no Beta.
MERCADOPAGO_WEBHOOK_REQUIRE_SIGNATURE=false

# AWS S3 — use buckets de teste ou deixe vazio (uploads falham de forma controlada).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_MANUAIS=
AWS_S3_BUCKET_IMAGENS=
AWS_S3_BUCKET_BACKUPS=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION=us-east-1
