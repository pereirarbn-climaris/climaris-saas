# Exemplo para copiar em `.env` na raiz (usado por `docker compose` para a API).
# Não commite o ficheiro `.env` real (está no .gitignore).

APP_ENV=local
DATABASE_URL=postgresql+psycopg://erp_user:erp_password@db:5432/erp_db
JWT_SECRET_KEY=troque_em_producao
JWT_BOOTSTRAP_TOKEN=troque_bootstrap_em_producao
# Chave Fernet base64 (urlsafe, 32 bytes) para criptografar credenciais da plataforma.
PLATFORM_API_CREDENTIALS_KEY=

# Mesmo valor que AUTHENTICATION_API_KEY em deploy/evolution/.env
EVOLUTION_API_KEY=

APP_PUBLIC_URL=https://app.seudominio.com.br
API_PUBLIC_BASE_URL=https://app.seudominio.com.br
EVOLUTION_CORS_REQUEST_ORIGIN=https://app.seudominio.com.br
# Se false, não injeta automaticamente domínios climaris.com.br no allowlist CORS.
INCLUDE_CLIMARIS_PROD_CORS_DEFAULTS=false

# Token na query do webhook (?token=) — mesmo valor de EVOLUTION_API_KEY / AUTHENTICATION_API_KEY
EVOLUTION_WEBHOOK_TOKEN=

# Obrigatório para processar respostas do cliente (CONFIRMAR / REMARCAR / CANCELAR)
WHATSAPP_WEBHOOK_ENABLED=true

# Em produção com mais de 1 réplica da API, deixe false e execute schedulers fora da API.
INPROCESS_SCHEDULERS_ENABLED=false

# Assinatura obrigatória para webhook MP em contas de produção (não sandbox).
MERCADOPAGO_WEBHOOK_REQUIRE_SIGNATURE=true

# Cadastro público: mantenha false em ambientes privados/internos.
PUBLIC_REGISTER_ENABLED=false

# Opcional para cron externo de preventiva sem JWT.
PREVENTIVE_CRON_SECRET=

# AWS S3 — buckets por finalidade (ou cadastre em Operação → Chaves API)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_MANUAIS=
AWS_S3_BUCKET_IMAGENS=
AWS_S3_BUCKET_BACKUPS=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION=us-east-1
# Backup diário do banco no S3 (UTC). 06:00 UTC = 03:00 BRT.
S3_DAILY_BACKUP_ENABLED=false
S3_DAILY_BACKUP_HOUR_UTC=6
S3_DAILY_BACKUP_MINUTE_UTC=0
# Prefixo no bucket: <prefix>/<YYYY>/<MM>/<banco_YYYY-MM-DD.sql.gz>
S3_DAILY_BACKUP_PREFIX=db-backups
# Defina true para manter cópia local em /tmp/climaris-backups após upload.
S3_DAILY_BACKUP_KEEP_LOCAL=false
# Compatível com credenciais legadas do projeto:
# AWS_S3_BUCKET=
# AWS_S3_PUBLIC_BASE_URL=
# AWS_S3_OBJECT_ACL=public-read
